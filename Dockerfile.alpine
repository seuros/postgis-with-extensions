# syntax=docker/dockerfile:1
##############################################################################
# PostgreSQL 18 (Alpine) + PostGIS + pgvector + pgRouting + pg_cron
#   + H3 + pg_partman + pgTAP + HypoPG + pg_repack
# – based on the official postgres Alpine variant, extensions compiled from
#   source against its /usr/local Postgres.
#
# Every extension builds in its own stage (BuildKit runs them in parallel) and
# installs into /out via DESTDIR; the final stage only copies /out and pulls
# the shared libraries the binaries actually link against. No toolchain ships.
#
# Keep the FROM tag in sync with Dockerfile (CI enforces it).
##############################################################################

# Global so it can select a stage below.
ARG WITH_PGROUTING=1

FROM postgres:18.6-alpine3.24 AS base

# ----- shared toolchain -----------------------------------------------------
FROM base AS toolchain
# $DOCKER_PG_LLVM_DEPS (set by the base image) is the clang/llvm matching the
# server's JIT build; PGXS needs it to emit bitcode.
RUN apk add --no-cache \
      $DOCKER_PG_LLVM_DEPS \
      build-base \
      cmake \
      curl \
      git \
      perl
WORKDIR /src

# ----- PostGIS (with raster + SFCGAL, matching the Debian package) ----------
FROM toolchain AS postgis
ARG POSTGIS_VERSION=3.6.4
RUN apk add --no-cache \
      gdal-dev geos-dev proj-dev sfcgal-dev \
      json-c-dev libxml2-dev pcre2-dev protobuf-c-dev
RUN set -eux; \
    curl -fsSL "https://download.osgeo.org/postgis/source/postgis-${POSTGIS_VERSION}.tar.gz" | tar -xz; \
    cd "postgis-${POSTGIS_VERSION}"; \
    ./configure --with-pgconfig=/usr/local/bin/pg_config; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

# ----- pgvector -------------------------------------------------------------
FROM toolchain AS pgvector
ARG PGVECTOR_VERSION=0.8.7
RUN set -eux; \
    git clone --depth 1 --branch "v${PGVECTOR_VERSION}" https://github.com/pgvector/pgvector.git; \
    cd pgvector; \
    # OPTFLAGS="" drops -march=native so the image runs on any CPU of the arch
    make -j"$(nproc)" OPTFLAGS=""; \
    make install DESTDIR=/out

# ----- pg_cron --------------------------------------------------------------
FROM toolchain AS pgcron
ARG PGCRON_VERSION=1.6.8
RUN set -eux; \
    git clone --depth 1 --branch "v${PGCRON_VERSION}" https://github.com/citusdata/pg_cron.git; \
    cd pg_cron; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

# The stages below are pinned to the versions Amazon RDS for PostgreSQL 18
# ships; keep them in sync with the Debian Dockerfile.

# ----- H3 (h3 + h3_postgis) -------------------------------------------------
FROM toolchain AS h3
ARG H3_VERSION=4.2.3
# CMake fetches the SHA256-pinned uber/h3 core and links it statically; only
# the extension component is installed, so no core headers/libs ship.
RUN set -eux; \
    git clone --depth 1 --branch "v${H3_VERSION}" https://github.com/postgis/h3-pg.git; \
    cmake -S h3-pg -B h3-pg/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_TESTING=OFF \
      -DPostgreSQL_CONFIG=/usr/local/bin/pg_config; \
    cmake --build h3-pg/build -j"$(nproc)"; \
    DESTDIR=/out cmake --install h3-pg/build --component h3-pg

# ----- pg_partman -----------------------------------------------------------
FROM toolchain AS pgpartman
ARG PGPARTMAN_VERSION=5.4.3
# SCRIPTS= skips the Python helper scripts: no python3/psycopg2 in this image.
RUN set -eux; \
    git clone --depth 1 --branch "v${PGPARTMAN_VERSION}" https://github.com/pgpartman/pg_partman.git; \
    cd pg_partman; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out SCRIPTS=

# ----- pgTAP ----------------------------------------------------------------
FROM toolchain AS pgtap
ARG PGTAP_VERSION=1.3.4
RUN set -eux; \
    git clone --depth 1 --branch "v${PGTAP_VERSION}" https://github.com/theory/pgtap.git; \
    cd pgtap; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

# ----- HypoPG ---------------------------------------------------------------
FROM toolchain AS hypopg
ARG HYPOPG_VERSION=1.4.2
RUN set -eux; \
    git clone --depth 1 --branch "${HYPOPG_VERSION}" https://github.com/HypoPG/hypopg.git; \
    cd hypopg; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

# ----- pg_repack (extension + client) ---------------------------------------
FROM toolchain AS pgrepack
ARG PGREPACK_VERSION=1.5.3
# The pg_repack client links the frontend libs from `pg_config --libs`.
# gawk: PGXS (AWK = gawk) builds the library's linker version script with it,
# and a missing gawk silently yields an empty script.
RUN apk add --no-cache gawk lz4-dev openssl-dev zlib-dev zstd-dev
RUN set -eux; \
    git clone --depth 1 --branch "ver_${PGREPACK_VERSION}" https://github.com/reorg/pg_repack.git; \
    cd pg_repack; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

# ----- pgRouting (skip with --build-arg WITH_PGROUTING=0) -------------------
FROM toolchain AS pgrouting-1
ARG PGROUTING_VERSION=4.0.2
RUN apk add --no-cache boost-dev
RUN set -eux; \
    git clone --depth 1 --branch "v${PGROUTING_VERSION}" https://github.com/pgRouting/pgrouting.git; \
    cmake -S pgrouting -B pgrouting/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DPOSTGRESQL_PG_CONFIG=/usr/local/bin/pg_config; \
    make -C pgrouting/build -j"$(nproc)"; \
    make -C pgrouting/build install DESTDIR=/out

FROM scratch AS pgrouting-0
WORKDIR /out

FROM pgrouting-${WITH_PGROUTING} AS pgrouting

# ----- everything the extensions install, as one tree ------------------------
FROM scratch AS extensions
COPY --from=postgis     /out/ /
COPY --from=pgvector    /out/ /
COPY --from=pgcron      /out/ /
COPY --from=h3          /out/ /
COPY --from=pgpartman   /out/ /
COPY --from=pgtap       /out/ /
COPY --from=hypopg      /out/ /
COPY --from=pgrepack    /out/ /
COPY --from=pgrouting   /out/ /

# ----- final image ----------------------------------------------------------
FROM base

# Default libpq user so client tools (psql, pg_isready) don't fall back to
# the runtime OS user (root in many CI environments), which avoids noisy
# "role \"root\" does not exist" connection attempts. Users can override.
ENV TZ=UTC \
    PGUSER=postgres

COPY --from=extensions / /

# Install exactly the shared libraries the extension binaries link against
# (same approach as the official images), then sanity-check the install.
# Only the extension tree is scanned: the base image's plperl/plpython/pltcl
# modules intentionally ship without their language runtimes.
RUN --mount=type=bind,from=extensions,target=/tmp/extensions \
    set -eux; \
    apk add --no-cache --virtual .scan-deps pax-utils; \
    runDeps="$( \
      scanelf --needed --nobanner --format '%n#p' --recursive /tmp/extensions \
        | tr ',' '\n' \
        | sort -u \
        | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
    )"; \
    apk add --no-cache --virtual .extension-rundeps ca-certificates $runDeps; \
    apk del --no-network .scan-deps; \
    ext="$(pg_config --sharedir)/extension"; \
    lib="$(pg_config --pkglibdir)"; \
    for e in postgis postgis_raster postgis_sfcgal postgis_topology vector pg_cron \
             h3 h3_postgis pg_partman pgtap hypopg pg_repack; do \
      test -f "$ext/$e.control"; \
    done; \
    for m in vector pg_cron h3 h3_postgis pg_partman_bgw hypopg pg_repack; do \
      test -f "$lib/$m.so"; \
    done; \
    ls "$lib"/postgis-3.so "$lib"/postgis_raster-3.so "$lib"/postgis_sfcgal-3.so; \
    # the client must resolve its shared libraries
    pg_repack --version

USER postgres

# pg_cron must be listed in shared_preload_libraries.
CMD ["postgres", "-c", "shared_preload_libraries=pg_cron"]
